# إعدادات السيرفر على Azure. انسخ هذا الملف إلى deploy/azure/.env وعبّئه، ثم شغّل deploy.ps1
# (ينسخه السكربت إلى /opt/daftar/.env على السيرفر). لا ترفعه إلى git.

# ── النطاق وشهادة HTTPS ─────────────────────────────────────────────
# اسم DNS الذي أعطيته لعنوان IP العام للجهاز في Azure (أو دومينك الخاص).
ERP_DOMAIN=daftar-store.uaenorth.cloudapp.azure.com
# بريد يُسجَّل لدى Let's Encrypt لتنبيهات الشهادة.
ERP_ACME_EMAIL=

# ── التطبيق ─────────────────────────────────────────────────────────
APP_NAME="دفتر | إدارة متجر الأجهزة"
APP_ENV=production
APP_DEBUG=false
# نفس المفتاح الموجود في backend/.env و .env — ضروري لفك تشفير البيانات المنقولة.
APP_KEY=
# https:// + ERP_DOMAIN
APP_URL=https://daftar-store.uaenorth.cloudapp.azure.com
FRONTEND_URL=https://daftar-store.uaenorth.cloudapp.azure.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Hebron

# ── قاعدة البيانات: Azure Database for MySQL (Flexible Server) ─────
DB_CONNECTION=mysql
# <اسم السيرفر>.mysql.database.azure.com   (أو db مع --profile localdb)
DB_HOST=
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=
# Azure يفرض اتصالاً مشفّراً؛ هذا ملف شهادات النظام داخل الحاوية ويحوي شهادات Azure الجذرية.
# اتركه فارغاً فقط عند استعمال --profile localdb.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# يُستخدم فقط مع --profile localdb.
DB_ROOT_PASSWORD=

# ── الجلسات (HTTPS) ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# نفس ERP_DOMAIN بدون https://
SANCTUM_STATEFUL_DOMAINS=daftar-store.uaenorth.cloudapp.azure.com

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@example.test"
MAIL_FROM_NAME="Store ERP"

RUN_MIGRATIONS=true
