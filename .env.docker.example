# انسخ هذا الملف إلى .env (بجانب docker-compose.yml) وعدّل القيم. لا ترفعه إلى git.
# Copy to .env next to docker-compose.yml. Never commit it.

# المنفذ الذي تفتح منه المنصة: http://<عنوان الجهاز>:<المنفذ>
ERP_HTTP_PORT=80

APP_NAME="دفتر | إدارة متجر الأجهزة"
APP_ENV=production
APP_DEBUG=false
# انسخ APP_KEY كما هو من backend/.env — بدونه لا يمكن فك تشفير الحسابات البنكية والجلسات المنقولة.
APP_KEY=
# عنوان الجهاز كما يكتبه المستخدم في المتصفح (أضف :المنفذ إن لم يكن 80).
APP_URL=http://localhost
FRONTEND_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Hebron

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp
# كلمتا مرور قويتان من اختيارك (تُستخدمان عند أول إنشاء لقاعدة البيانات فقط).
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# اجعلها true فقط عند العمل عبر HTTPS (مثلاً Cloudflare Tunnel).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# كل عنوان يُفتح منه النظام، مع المنفذ إن لم يكن 80. مثال: localhost,127.0.0.1,192.168.1.20
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
# stderr يجعل الأخطاء تظهر في: docker compose logs app
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
MAIL_FROM_ADDRESS="erp@example.test"
MAIL_FROM_NAME="Store ERP"

# ينفّذ migrate تلقائياً عند تشغيل الحاوية، و db:seed إن كانت القاعدة جديدة فارغة.
RUN_MIGRATIONS=true
