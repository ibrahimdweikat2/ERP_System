{"nodes": [{"id": "readme", "label": "Daftar ERP root README", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_daftar_erp", "label": "Daftar (\u062f\u0641\u062a\u0631) ERP for a single appliance store", "file_type": "concept", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_laravel_sanctum_backend", "label": "Laravel 12 / Sanctum API backend", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_mysql_8_4", "label": "MySQL 8.4 database", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_database_queue", "label": "Laravel database queue driver", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_react_typescript_tailwind_frontend", "label": "React / TypeScript / Tailwind frontend", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_arabic_rtl_interface", "label": "Arabic RTL interface", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_phase_gates", "label": "Implementation phase gates (IMPLEMENTATION_PROGRESS.md)", "file_type": "rationale", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERP is built incrementally through phase gates; unimplemented modules are visibly unavailable. Production release requires every applicable phase gate, reconciliation, restore rehearsal and accountant configuration review."}, {"id": "readme_local_dev_topology", "label": "Local development topology (MySQL 3307/3308, API 8188, UI 5173)", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active store erp_store_mysql8 on MySQL 3307; a separate MySQL on 3308 hosts erp_test and erp_browser_test with data on C: to isolate test I/O from the active store on E:."}, {"id": "readme_mariadb_migration", "label": "Authorized MariaDB to MySQL migration", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing accounts and passwords preserved; env, schema/data backup, SHA-256 manifest and row/FK verification report kept in ignored .runtime/migration-backups; source MariaDB database preserved."}, {"id": "readme_erp_create_owner_command", "label": "php artisan erp:create-owner", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No fixed default password is committed, so the first owner on a new installation is provisioned explicitly after migrations and seeding."}, {"id": "readme_start_development_script", "label": "scripts/start-development.ps1", "file_type": "concept", "source_file": "README.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_least_privilege_db_credentials", "label": "Least-privilege production DB credentials", "file_type": "rationale", "source_file": "README.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated migration account holds trigger-creation privileges; production runtime credentials must not have schema-altering privileges or update/delete on audit and posted ledger tables."}, {"id": "readme_same_origin_proxy", "label": "Same-origin SPA serving with /api and /sanctum proxy", "file_type": "rationale", "source_file": "README.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serve frontend dist and proxy /api and /sanctum to Laravel on the same origin, with secure session cookies and HTTPS in production (Sanctum stateful cookie auth)."}, {"id": "readme_verification_workflow", "label": "Verification workflow (artisan test, pint, npm build/lint)", "file_type": "concept", "source_file": "README.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_test_database_guard", "label": "Test database name guard (_test suffix)", "file_type": "rationale", "source_file": "README.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend tests refuse to run unless the database name ends in _test; the guard runs before Laravel's migration test hooks so the active store is never touched. Tests use real MySQL migrations, triggers, concurrent processes and workers."}, {"id": "readme_browser_test_store", "label": "Isolated browser test store (API 8199 / UI 5199)", "file_type": "concept", "source_file": "README.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend and browser suites run sequentially because concurrent MySQL schema rebuilds cause I/O-related browser timeouts; -ResetData only resets the checked browser test database."}, {"id": "readme_playwright_e2e", "label": "Playwright end-to-end browser tests", "file_type": "concept", "source_file": "README.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_queue_workers", "label": "Queue workers (default; reports,exports; notifications,maintenance)", "file_type": "concept", "source_file": "README.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queue reservation timeout (360s) is above the longest worker timeout; core financial posting stays inside the request transaction rather than on the queue."}, {"id": "readme_scheduler", "label": "Laravel scheduler (schedule:run every minute)", "file_type": "concept", "source_file": "README.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_erp_queue_probe", "label": "php artisan erp:queue-probe", "file_type": "concept", "source_file": "README.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_supervisor_configuration", "label": "Supervisor configuration (deploy/supervisor.conf)", "file_type": "concept", "source_file": "README.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_immutable_posted_journals", "label": "Immutable posted journals (MySQL-level triggers)", "file_type": "rationale", "source_file": "README.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Posted journals are immutable at the MySQL level; reversals preserve their original currency conversion."}, {"id": "readme_pre_operation_configuration", "label": "Pre-operation configuration (store identity, fiscal years, tax versions, account mappings)", "file_type": "concept", "source_file": "README.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No operational opening balances or live VAT rate are seeded, so these must be configured (and reviewed by an accountant) before operations."}], "edges": [{"source": "readme", "target": "readme_daftar_erp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L1", "weight": 1.0}, {"source": "readme_daftar_erp", "target": "readme_laravel_sanctum_backend", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme_daftar_erp", "target": "readme_mysql_8_4", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme_daftar_erp", "target": "readme_react_typescript_tailwind_frontend", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme_daftar_erp", "target": "readme_arabic_rtl_interface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme_daftar_erp", "target": "readme_phase_gates", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L5", "weight": 1.0}, {"source": "readme_laravel_sanctum_backend", "target": "readme_database_queue", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L3", "weight": 1.0}, {"source": "readme_queue_workers", "target": "readme_database_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L57", "weight": 1.0}, {"source": "readme_queue_workers", "target": "readme_supervisor_configuration", "relation": "references"