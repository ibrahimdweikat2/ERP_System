{"nodes": [{"id": "docs_18_performance_mysql_and_queue", "label": "Performance, MySQL and Laravel Queue", "file_type": "document", "source_file": "docs/18_PERFORMANCE_MYSQL_AND_QUEUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_18_performance_mysql_and_queue_mysql_strategy", "label": "MySQL Query Strategy", "file_type": "concept", "source_file": "docs/18_PERFORMANCE_MYSQL_AND_QUEUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composite indexes from real filters, EXPLAIN ANALYZE, intentional eager-loading, column selection, chunked exports, short transactions and targeted row locks."}, {"id": "docs_18_performance_mysql_and_queue_summary_tables", "label": "Summary Tables", "file_type": "rationale", "source_file": "docs/18_PERFORMANCE_MYSQL_AND_QUEUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived aggregates are permitted for performance only while the source ledger remains immutable and auditable; summaries never replace the ledger."}, {"id": "docs_18_performance_mysql_and_queue_inventory_balances", "label": "inventory_balances Table", "file_type": "concept", "source_file": "docs/18_PERFORMANCE_MYSQL_AND_QUEUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_18_performance_mysql_and_queue_caching_without_redis", "label": "Caching Without Redis", "file_type": "rationale", "source_file": "docs/18_PERFORMANCE_MYSQL_AND_QUEUE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File/database cache only for low-risk reference data; cache is never a correctness requirement and rapidly changing financial balances are not cached without a clear invalidation design."}, {"id": "docs_18_performance_mysql_and